{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,

    "types": ["node", "next", "next/navigation"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/context/*": ["./src/context/*"],
      "@/lib/*": ["./src/lib/*"],
      "@firebasegen/*": ["./dataconnect-generated/js/*"],
      "@firebasegen/default-connector": ["./dataconnect-generated/js/default-connector"],
      "@firebasegen/default-connector/*": ["./dataconnect-generated/js/default-connector/*"]
    },

    "outDir": "./lib",
    "sourceMap": true,
    "plugins": [{ "name": "next" }],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "dataconnect-generated/js/**/*.ts",
    "src/types",
    "src/types/firebase-fix.d.ts",
    "src/types/firebasegen.d.ts",
    "src/components/ThemeToggle.js"
  ],
  "exclude": ["node_modules", "lib", "**/*.test.ts", "**/*.test.tsx"]
}