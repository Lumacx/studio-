{
  "name": "narratum-functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
    "build:deploy": "rimraf lib tsconfig.tsbuildinfo && tsc -p tsconfig.json && node -e \"['./lib/index.js','./lib/imageGeneration.js','./lib/authTriggers.js','./lib/commentCounter.js','./lib/assetsIndex.js'].forEach(p=>require('fs').accessSync(p))\" && ls -la lib",
    "serve": "firebase emulators:start --only functions --project narratum",
    "deploy": "firebase deploy --only functions --project narratum"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sparticuz/chromium": "126.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^7.0.5",
    "puppeteer-core": "23.11.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
